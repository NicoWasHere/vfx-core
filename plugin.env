# The plugin's identity, in one place. A project forked from vfx-core edits these, and
# every wrapper, build script and installer reads them. Bash scripts source this file;
# the wrappers' build.rs scripts parse it, so keep each line as KEY="value".
#
# Hosts find a plugin in saved projects by its IDs (PLUGIN_ID, AE_MATCH_NAME, FFGL_ID):
# choose them once and keep them across versions.

PLUGIN_NAME="VFX Preview"                # in each host's effect list (FFGL: 16 bytes at most)
PLUGIN_CATEGORY="vfx-core"               # After Effects category and OpenFX grouping
PLUGIN_FILE="VfxPreview"                 # bundles, DLLs, installers and logs (no spaces)
PLUGIN_ID="com.vfx-core.VfxPreview"      # OpenFX identifier; macOS bundle IDs start with it
AE_MATCH_NAME="VFXPreview"               # After Effects match name
FFGL_ID="VFXP"                           # FFGL plugin code: exactly 4 characters
WINDOWS_INSTALLER_ID="2FFBD5EA-ABD9-4A8F-9ACC-24CF0C2C2E3E"  # Inno Setup AppId, a GUID of its own
